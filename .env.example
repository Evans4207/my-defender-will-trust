# ---------------------------------------------------------------------------
# My Defender Will & Trust — environment variables
# Copy this file to .env.local and fill in real values. Never commit secrets.
# Separate values are used per environment (dev / staging / prod).
# ---------------------------------------------------------------------------

# --- Supabase (Project Settings → API) ---
# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Secret: server-only. Bypasses Row-Level Security — NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Direct Postgres connection string (Project Settings → Database).
# Used by migrations / seed scripts, not by the app runtime.
SUPABASE_DB_URL="postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT-ref.supabase.co:5432/postgres"

# --- App ---
# Public base URL of this environment (used for auth redirects, emails).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret for the scheduled reminders cron (Vercel Cron sends it as a Bearer token).
CRON_SECRET=""

# --- Stripe (Phase 1) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Price IDs (Stripe Dashboard → Products). Packages are one-time; membership recurs.
STRIPE_PRICE_WILL_INDIVIDUAL=""
STRIPE_PRICE_WILL_COUPLES=""
STRIPE_PRICE_TRUST_INDIVIDUAL=""
STRIPE_PRICE_TRUST_COUPLES=""
STRIPE_PRICE_MEMBERSHIP=""

# --- Email (Phase 3 — Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="My Defender Will & Trust <noreply@mydefenderplan.com>"

# --- PDF conversion (Phase 3 — optional; DOCX always works without these) ---
# Preferred: a Gotenberg service URL. Fallback: local LibreOffice `soffice`.
GOTENBERG_URL=""
# SOFFICE_PATH="/Applications/LibreOffice.app/Contents/MacOS/soffice"

# Version string for the self-help disclaimer, written to every consent record.
# MUST be set to the value counsel approves before production. Leaving it unset
# resolves to a placeholder and document generation refuses to run in production.
DISCLAIMER_VERSION=

# Pre-launch ONLY. A hosted test deployment runs as NODE_ENV=production, which would
# otherwise block document generation while DISCLAIMER_VERSION is a placeholder. Set
# this to "true" on the test deployment, and REMOVE it the moment counsel supplies a
# real version. Consent records written under it are stamped "unapproved-placeholder".
ALLOW_PLACEHOLDER_DISCLAIMER=
